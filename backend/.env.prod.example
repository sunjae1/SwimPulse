SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework

# AWS Lightsail Managed MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_MANAGED_MYSQL_ENDPOINT:3306/swimpulse?useSSL=true&serverTimezone=UTC&connectTimeout=5000&socketTimeout=30000
SPRING_DATASOURCE_USERNAME=swimpulse
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=1
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Docker Compose service name
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Production logging
SWIMPULSE_APP_LOG_LEVEL=INFO
SWIMPULSE_SQL_LOG_LEVEL=OFF
SWIMPULSE_SQL_BIND_LOG_LEVEL=OFF

# Vercel frontend + local development origins.
# Replace the Vercel domain after the first deployment.
SWIMPULSE_CORS_ALLOWED_ORIGIN_PATTERNS=https://YOUR_VERCEL_PROJECT.vercel.app,http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
SWIMPULSE_OAUTH2_REDIRECT_URI=https://YOUR_API_DOMAIN/login/oauth2/code/google
SWIMPULSE_AUTH_SUCCESS_REDIRECT_URI=https://YOUR_VERCEL_PROJECT.vercel.app?login=success
SWIMPULSE_AUTH_FAILURE_REDIRECT_URI=https://YOUR_VERCEL_PROJECT.vercel.app?login=error

# JWT cookie.
# If frontend and backend use different sites, use SameSite=None + Secure=true.
SWIMPULSE_JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
SWIMPULSE_JWT_EXPIRATION_HOURS=168
SWIMPULSE_AUTH_COOKIE_SECURE=true
SWIMPULSE_AUTH_COOKIE_SAME_SITE=None

# Firebase Admin SDK. Use true temporarily if push sending is not ready.
SWIMPULSE_FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-adminsdk.json
SWIMPULSE_FIREBASE_MOCK=false

# Naver APIs
NAVER_MAPS_CLIENT_ID=CHANGE_ME
NAVER_MAPS_CLIENT_SECRET=CHANGE_ME
NAVER_SEARCH_CLIENT_ID=CHANGE_ME
NAVER_SEARCH_CLIENT_SECRET=CHANGE_ME

# Load test/internal endpoints should stay off in production.
SWIMPULSE_LOADTEST_ENABLED=false

# OpenAI notice extraction is not used in current prod path.
OPENAI_API_KEY=
SWIMPULSE_OPENAI_MODEL=gpt-5.4-mini

# OCR
SWIMPULSE_NOTICE_OCR_ENABLED=true
SWIMPULSE_NOTICE_OCR_COMMAND=tesseract
SWIMPULSE_NOTICE_OCR_LANGUAGES=kor+eng
SWIMPULSE_NOTICE_OCR_MAX_IMAGES=3
SWIMPULSE_NOTICE_OCR_TIMEOUT_MS=15000
SWIMPULSE_NOTICE_OCR_QUEUE_KEY=swimpulse:notice-ocr
SWIMPULSE_NOTICE_OCR_WORKER_DELAY_MS=2000
SWIMPULSE_NOTICE_OCR_WORKER_BATCH_SIZE=2
SWIMPULSE_NOTICE_OCR_SCHEDULER_POOL_SIZE=1

# Worker sizes for 2GB RAM instance.
SWIMPULSE_NOTIFICATION_WORKER_DELAY_MS=1000
SWIMPULSE_NOTIFICATION_WORKER_BATCH_SIZE=10
SWIMPULSE_NOTIFICATION_SCHEDULER_POOL_SIZE=1
SWIMPULSE_EVENT_SCHEDULER_DELAY_MS=30000
SWIMPULSE_EVENT_SCHEDULER_POOL_SIZE=1
